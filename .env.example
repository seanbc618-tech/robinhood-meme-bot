# Copy to .env.telegram (ignored); keep permissions 0600.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# RPC settings go in .env.rpc (ignored), not .env.telegram.
# ROBINHOOD_RPC_URL=your Alchemy Robinhood mainnet endpoint
# Optional dedicated log endpoint; otherwise the public Robinhood log RPC is used.
# ROBINHOOD_LOG_RPC_URL=your Robinhood-compatible log endpoint
# Optional slow failover list: comma-separated label|URL entries. Keep these sequential;
# QuickNode/Dwellir/NodeFlare/Blockdaemon dedicated URLs should carry their own key.
# Optional slow log providers; use label[:max_block_range]|URL, comma-separated.
# ROBINHOOD_LOG_RPC_URLS=quicknode-discover:5|https://{ENDPOINT}.robinhood-mainnet.quiknode.pro/{TOKEN},quicknode-demo|https://docs-demo.robinhood-mainnet.quiknode.pro/,nodeflare|https://rpc.nodeflare.app/robinhood/v1/{KEY}
# ROBINHOOD_TRACE_RPC_URL=your trace-capable endpoint
# ROBINHOOD_WALLET=your public wallet address
