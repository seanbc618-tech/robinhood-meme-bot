# Copy to .env.telegram (ignored); keep permissions 0600.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# RPC settings go in .env.rpc (ignored), not .env.telegram.
# ROBINHOOD_RPC_URL=your Alchemy Robinhood mainnet endpoint
# Optional dedicated log endpoint; otherwise the public Robinhood log RPC is used.
# ROBINHOOD_LOG_RPC_URL=your Robinhood-compatible log endpoint
# ROBINHOOD_TRACE_RPC_URL=your trace-capable endpoint
# ROBINHOOD_WALLET=your public wallet address
